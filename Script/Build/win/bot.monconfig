[bot]
NAME=EDEN Bot
NICKNAMES=EDEN
[nonebot]
DRIVER=~websockets
HOST=127.0.0.1
PORT=8080
SUPERUSERS=
[onebot]
WS_URLS=ws://127.0.0.1:3001
ACCESS_TOKEN=
[moncore]
IP=127.0.0.1
HTTP_HOST=127.0.0.1
WS_PORT=40011
PAIRING_TOKEN=
[features]
VOICE_MODE_ENABLED=true
ENABLE_MENTION_REPLY=true
ENABLE_NAME_MENTION=true
[permissions]
GROUP_DEFAULT_PERMIT=false
PRIVATE_DEFAULT_PERMIT=false
GROUP_ALLOW_LIST=
PRIVATE_ALLOW_LIST=
[debug]
HOT_RELOAD=false
